# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# uv lockfile (the package is published; a lock belongs to whoever installs it)
uv.lock

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/

# Sphinx build output
docs/build/

# Quarto user site build output (the Sphinx developer site is built into _site/dev)
website/_site/
website/.quarto/
**/*_files/

# Local archive downloaded by `dofjson --archivo` (local only, never committed)
/notas-archivo/

# Local copy of the release downloaded by scripts/copiar_notas_archivo.py (never committed)
/notas-archivo-copia/

# Local output from dofjson runs (downloaded notes, PDFs, images)
/output/

# Editor / OS
.DS_Store
.ropeproject/

# Local Claude Code settings (not shared)
.claude/settings.local.json
